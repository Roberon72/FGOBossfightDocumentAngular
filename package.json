{
  "name": "fgobossfight-doc-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "bun run scripts/create-bossfight-manifest.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "github-build": "ng build --configuration production --base-href '/FGOBossfightDocumentAngular/'",
